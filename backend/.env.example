PORT=4000
# Comma-separated list of allowed browser origins
FRONTEND_ORIGIN=http://localhost:5173
# Local PostgreSQL example (create the database first):
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/omni_voice_ai
# For managed providers such as Neon, set DATABASE_SSL=true if required by your provider.
DATABASE_SSL=false
DB_POOL_MAX=10
# --- AI (chat) --------------------------------------------------------------
# Any provider works: set its API key, model name and base URL.
# The API type is detected from the base URL (Gemini, Anthropic, or OpenAI-compatible for everything else).
#
#   Gemini      AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta   AI_MODEL=gemini-2.5-flash
#   OpenAI      AI_BASE_URL=https://api.openai.com/v1                          AI_MODEL=gpt-4o-mini
#   Anthropic   AI_BASE_URL=https://api.anthropic.com                          AI_MODEL=claude-haiku-5-5
#   Groq        AI_BASE_URL=https://api.groq.com/openai/v1                     AI_MODEL=llama-3.3-70b-versatile
#   OpenRouter  AI_BASE_URL=https://openrouter.ai/api/v1                       AI_MODEL=<any model id>
#   Ollama      AI_BASE_URL=http://localhost:11434/v1                          AI_MODEL=llama3.1   (no key needed)
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# AI_JSON_MODE=false   # set to false if an OpenAI-compatible server rejects response_format

# --- Speech-to-text ---------------------------------------------------------
# Leave these empty to use the same service as above (works for Gemini).
# Otherwise point them at any service with an OpenAI-style /audio/transcriptions endpoint (or Gemini).
# Needed when the chat provider has no speech-to-text, e.g. Anthropic, Ollama, OpenRouter.
#   OpenAI  STT_BASE_URL=https://api.openai.com/v1   STT_MODEL=whisper-1
#   Groq    STT_BASE_URL=https://api.groq.com/openai/v1   STT_MODEL=whisper-large-v3-turbo
# STT_API_KEY=
# STT_MODEL=
# STT_BASE_URL=
